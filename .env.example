# このファイルを .env にコピーして使う（.env は git 管理外）。
#   cp .env.example .env
# `npm run dev` / `npm start` / `npm run seed-user` が --env-file-if-exists=.env で
# 読み込む。実行時の環境変数のほうが .env より優先される。
#
# ここに載っているのはコードが実際に読む変数だけ（server/src/config.ts、
# server/scripts/seed-user.ts、client/vite.config.ts）。

# --- 必須 -------------------------------------------------------------------

# 唯一のユーザーの資格情報。`npm run seed-user` がこの 2 つからユーザーを
# 作成し、既にいればパスワードを更新する（登録画面は無い）。
# パスワードは平文で保存されず、scrypt ハッシュだけが DB に入る。
# seed-user はどちらかが未設定だと exit 1 で止まる。
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- 任意（既定値で動く） ---------------------------------------------------

# API サーバーが待ち受けるポート。既定 3001
PORT=3001

# SQLite ファイルのパス。相対パスは実行時のカレントディレクトリ
# （npm script 経由ならリポジトリルート）基準で解決される。既定 data/habits.db
# 親ディレクトリは起動時に自動作成される。
DB_PATH=data/habits.db

# セッション Cookie に Secure を付けるかどうか。auto / true / false。既定 auto
#   auto  … リクエストが実際に来たスキームで決める。https なら付け、http なら
#           付けない。TLS を終端するリバースプロキシの後ろでは
#           X-Forwarded-Proto を見る（プロキシがこのヘッダを設定しない場合だけ
#           true を明示する）
#   true  … 常に付ける
#   false … 常に付けない
# NODE_ENV では決めない: Secure は「接続」の性質であってビルド種別ではなく、
# http で Secure Cookie を出すとブラウザが黙って捨てて認証が壊れる。
COOKIE_SECURE=auto

# --- 開発時のみ -------------------------------------------------------------

# Vite dev サーバー（:5173）が /api をどのポートへ proxy するか。
# 未設定なら PORT、それも無ければ 3001。本番配信では使わない。
# API_PORT=3001

# サーバーのコード自体は NODE_ENV を読まない（Cookie の Secure は COOKIE_SECURE と
# リクエストのスキームで決まる）。Vite のビルドと一部のライブラリが見るだけなので、
# .env に書く必要は無い。
