# API サーバーが待ち受けるポート（既定 3001）
PORT=3001

# SQLite ファイルのパス。相対パスは実行時のカレントディレクトリ
# （npm script 経由ならリポジトリルート）基準で解決される。既定 data/habits.db
DB_PATH=data/habits.db

# 唯一のユーザーの資格情報。`npm run seed-user` がこの 2 つからユーザーを
# 作成し、既にいればパスワードを更新する（登録画面は無い）。
# パスワードは平文で保存されず、scrypt ハッシュだけが DB に入る。
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
