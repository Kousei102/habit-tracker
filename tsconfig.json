{
  /* Repo-wide check so a bare `npx tsc --noEmit` at the root covers everything,
     including the Playwright specs. client/tsconfig.json additionally checks the
     app under the module resolution Vite actually uses. */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  /* `e2e/**` is included so `npx tsc --noEmit` also type-checks the Playwright
     specs. They are the executable form of the acceptance criteria; a spec that
     does not compile is a spec that silently proves nothing. */
  "include": [
    "shared/**/*.ts",
    "client/src/**/*.ts",
    "client/src/**/*.tsx",
    "client/vite.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ]
}
